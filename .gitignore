# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example
# NEXT_PUBLIC_* only — anon key + URL, already public once shipped to any
# browser bundle; Vercel needs this file present at build time since no env
# var management tool is available from this session.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# jamais d'export Instagram décompressé ou zippé dans le repo (dépôt
# public) : ces dossiers contiendraient des données personnelles réelles
# (abonnés, messages) — même par accident via un `git add -A` malheureux.
connections/
logged_information/
your_instagram_activity/
personal_information/
preferences/
security_and_login_information/
ads_information/
apps_and_websites_off_of_instagram/
*.zip
